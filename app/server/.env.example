# Set these in the process environment before starting the API.
WENSHU_ADMIN_EMAIL=admin@example.org
WENSHU_ADMIN_PASSWORD=
WENSHU_JWT_SECRET=
# Optional paths, relative to the server working directory.
WENSHU_DB=wenshu.db
WENSHU_VAULT_DIR=../public/vault
# Enable when served over HTTPS.
WENSHU_COOKIE_SECURE=0
# Optional comma-separated explicit frontend origins. Never use * with cookies.
WENSHU_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://tauri.localhost,tauri://localhost
