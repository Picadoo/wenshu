{
  "name": "wenshu",
  "version": "0.1.0",
  "description": "Open source bilingual research library and local reading workspace",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/prepare-vendors.mjs",
    "sample": "python scripts/sync-vault.py --vault ../examples/vault --no-activity",
    "sync": "python scripts/sync-vault.py",
    "predev": "node scripts/ensure-sample.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/ensure-sample.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:markdown": "node scripts/check-markdown.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@emotion/react": "11.13.5",
    "@emotion/styled": "11.13.5",
    "@iconify/react": "5.0.2",
    "@mui/material": "6.1.10",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "axios": "1.20.0",
    "dompurify": "3.4.16",
    "katex": "0.18.2",
    "marked": "12.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.4",
    "turndown": "7.2.0",
    "yet-another-react-lightbox": "3.21.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "22.10.1",
    "@types/react": "18.3.13",
    "@types/react-dom": "18.3.1",
    "@types/turndown": "5.0.5",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "typescript": "5.7.2",
    "vite": "6.4.4"
  }
}
